# NexG environment variables
#
# Every variable in the M0 table of docs/NexG-Front-Door-Build-Plan.md.
# Copy to .env.local and fill in. NEVER commit real keys — .env* is gitignored
# except this file.
#
#   cp .env.example .env.local
#
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser. Everything else is
# server-only and must never appear in client code.

# ---------------------------------------------------------------- Supabase
# Source: Supabase project settings → API / Database
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ------------------------------------------------------- Google OAuth (staff)
# Source: Google Cloud → APIs & Services → Credentials (Web application)
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# Staff sign-in is restricted to this Workspace domain (spec section 5.1).
STAFF_EMAIL_DOMAIN=nexgapp.com

# Google Maps is further down, under its own heading. An earlier pair of
# names (BROWSER_KEY / SERVER_KEY) was written here before anything read
# them, and two naming schemes in one file is how somebody sets the half
# the code is not looking at.

# ------------------------------------------------------- SMS (Africa's Talking)
# Sandbox credentials are fine until the NEXG sender ID is registered.
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=NEXG

# ------------------------------------------------------------ Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="NexG <hello@mail.nexgapp.com>"

# ------------------------------------------------ Observability and analytics
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ------------------------------------------------------------------- Apps
# Absolute origin, used for OAuth redirects, sitemap and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Machine translation, so a visitor whose phone is set to any language
# gets the site in it. A Google Cloud Translation v2 API key. Without it
# the site serves English and Kiswahili only — which it says plainly on
# the welcome card rather than offering a language it cannot produce.
# Charged per character; each language is translated once and cached
# forever in public.translation.
TRANSLATION_API_KEY=

# How many new languages may be generated in a day. The generation path
# is reachable by anonymous visitors, so this is the cost ceiling.
TRANSLATION_DAILY_LOCALE_CAP=25

# ── Google Maps ────────────────────────────────────────────────
# Both are required. A key without a Map ID gives Google's default
# style and Advanced Markers silently refuse to render, which looks
# exactly like a bug in our code. Restrict the key to the Maps
# JavaScript API and to your own referrers.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_ID=

# ── Paystack ───────────────────────────────────────────────────
# The secret key never reaches a browser. The admin console needs
# only the secret — it sends refunds and cannot take a payment.
# Start with sk_test_; the mode is read from the key's own prefix.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Webhook, set in the Paystack dashboard:
#   https://<web domain>/api/payments/paystack/webhook
