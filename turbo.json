{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [".env.example", "tsconfig.json", "discovery/**"],
  "globalEnv": [
    "NODE_ENV",
    "ANALYZE",
    "VERCEL_URL",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_WEB_ORIGIN",
    "NEXT_PUBLIC_GOOGLE_MAPS_API_KEY",
    "NEXT_PUBLIC_GOOGLE_MAPS_ID",
    "GOOGLE_MAPS_API_KEY",
    "NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY",
    "NEXT_PUBLIC_VAPID_PUBLIC_KEY",
    "NEXT_PUBLIC_QR_ORIGIN",
    "NEXT_PUBLIC_NOTIFICATIONS_WORKER",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY",
    "NEXT_PUBLIC_AUTH_GOOGLE",
    "NEXT_PUBLIC_AUTH_APPLE",
    "TURNSTILE_SECRET_KEY",
    "VERCEL",
    "CI",
    "DISCOVERY_BASE",
    "DISCOVERY_ALLOW_LOCAL_SUPABASE",
    "NEXG_CHECKOUT_PATH",
    "NEXG_SIGN_IN_PATH"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "public/discover/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
