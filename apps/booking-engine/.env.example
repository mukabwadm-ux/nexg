BOOKING_PORT=3003
BOOKING_HOST=127.0.0.1
# Must be identical to the private bridge secret in apps/web. Never expose it to the browser.
BOOKING_BRIDGE_SECRET=
# Optional for local development; a random secret is persisted under .data if absent.
PAYLOAD_SECRET=
# Local development uses a separate SQLite file, never the existing portal database.
BOOKING_SQLITE_URL=file:./.data/booking.db
# Production uses PostgreSQL; schema push is disabled in production.
# BOOKING_DATABASE_URL=postgres://user:password@localhost:5432/nexg_booking
# BOOKING_DB_PUSH=false
