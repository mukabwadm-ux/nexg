# NexG Sandbox Bank. Copy to .env on the machine that runs it; never commit .env.
# Generate both values there, e.g.:  openssl rand -hex 24   and   openssl rand -hex 32
SANDBOX_API_KEY=                 # 24+ characters; NexG's BANK_API_KEY is the same value
SANDBOX_WEBHOOK_SECRET=          # 32+ characters; NexG's BANK_WEBHOOK_SECRET is the same value
PUBLIC_URL=http://localhost:4010 # where customers reach the approval page
PORT=4010
HOST=127.0.0.1                   # 0.0.0.0 inside a container
DATA_FILE=                       # optional, e.g. /data/sandbox.json, to keep state across restarts
COLLECTION_TTL_MINUTES=30
SLOW_APPROVAL_SECONDS=20
