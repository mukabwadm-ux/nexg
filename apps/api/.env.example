# Public API server
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=https://api.nexgapp.com
# Server only. Needed for the PostgreSQL limiter and private order reader.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional. Leave empty for the fleet-wide shared anonymous bucket (120 tokens/min).
# Set only when the hosting ingress removes the incoming header and overwrites it
# with exactly one verified client IP. Never trust a caller-controlled forwarded header.
# Example for an ingress you control: x-nexg-client-ip
API_TRUSTED_PROXY_IP_HEADER=
