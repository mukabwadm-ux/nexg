# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
dist-ssr/
build/
.vite/

# ...but `build/` is a route name as well as an output directory, and a
# bare pattern matches at every depth. /experience/build is a page, and
# without this it is silently never committed and never deployed.
!apps/web/app/**/build/
!apps/web/app/**/build/**
!apps/admin/app/**/build/
!apps/admin/app/**/build/**

# Environment
.env
.env.*
!.env.example

# Supabase
.branches
.temp
supabase/.temp/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.local

# Test / coverage
coverage/
playwright-report/
test-results/

# Turborepo
.turbo/

# Next.js
.next/
next-env.d.ts
.vercel

# Generated
*.tsbuildinfo

# Credential scratch files — never commit these.
# Keep real keys in .env.local (already ignored above) or a password manager.
nexgcr.txt
*credential*
*secret*
*.pem
*.key

# Dev-server output, kept separate from the production build.
.next-dev/
