{
  "name": "@nexg/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "A typed TypeScript client for the NexG API (api.nexgapp.com), with order-event signature checking",
  "keywords": [
    "nexg",
    "api",
    "delivery",
    "kenya",
    "webhooks"
  ],
  "homepage": "https://api.nexgapp.com/docs/client-library",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "generate": "node scripts/generate-types.mjs && prettier --write src/types.ts",
    "prepack": "pnpm run build",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf .turbo node_modules dist"
  },
  "devDependencies": {
    "@nexg/config": "workspace:*",
    "@nexg/contracts": "workspace:*",
    "eslint": "8.57.1",
    "rimraf": "6.0.1",
    "typescript": "5.7.2",
    "vitest": "2.1.8",
    "zod": "3.24.1"
  }
}
