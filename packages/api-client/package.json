{
  "name": "@nexg/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "A typed TypeScript client for the NexG API (api.nexgapp.com), with order-event signature checking",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "echo \"@nexg/api-client is consumed as source; it is not published yet\"",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf .turbo node_modules"
  },
  "devDependencies": {
    "@nexg/config": "workspace:*",
    "@nexg/contracts": "workspace:*",
    "eslint": "8.57.1",
    "rimraf": "6.0.1",
    "typescript": "5.7.2",
    "vitest": "2.1.8",
    "zod": "3.24.1"
  }
}
