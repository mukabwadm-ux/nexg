{
  "name": "@nexg/db",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.generated.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "echo \"@nexg/db is consumed as source via transpilePackages\"",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:types": "supabase gen types typescript --local --schema public --schema audit > src/types.generated.ts",
    "clean": "rimraf .turbo node_modules"
  },
  "devDependencies": {
    "@nexg/config": "workspace:*",
    "eslint": "8.57.1",
    "rimraf": "6.0.1",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
