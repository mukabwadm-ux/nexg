{
  "name": "@nexg/merchant-agreement",
  "version": "0.1.0",
  "private": true,
  "description": "NexG merchant agreements: the template built from the Word originals, filled in and rendered as a signed PDF on the NexG letterhead",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./details": "./src/details.ts",
    "./invoice": "./src/invoice.ts",
    "./package.json": "./package.json",
    "./documents": "./src/finance-docs/index.ts"
  },
  "scripts": {
    "build": "echo \"@nexg/merchant-agreement is consumed as source via transpilePackages\"",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf .turbo node_modules"
  },
  "dependencies": {
    "@nexg/contracts": "workspace:*",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@nexg/config": "workspace:*",
    "@types/node": "20.17.10",
    "@types/qrcode": "1.5.6",
    "eslint": "8.57.1",
    "rimraf": "6.0.1",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
