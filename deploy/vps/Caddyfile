# HTTPS for the NexG services on the VPS. Caddy gets and renews each
# certificate itself once the domain's DNS points at this server.
{
	email {$ACME_EMAIL}
}

(headers) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}

{$BOOKING_DOMAIN} {
	import headers
	reverse_proxy booking-engine:3003
}

# The discovery engine (docker compose --profile discovery up -d). Until
# DISCOVERY_DOMAIN is set in .env this answers only a local placeholder name.
{$DISCOVERY_DOMAIN:discovery.localhost} {
	import headers
	reverse_proxy discovery-engine:5190
}
