# Copy to .env on the VPS and fill it in there:
#   cp .env.example .env && chmod 600 .env
#
# The repository is public. .env is ignored by git; never commit it, and never
# paste these values into chat, issues or pull requests.
#
# Generate each secret on the VPS, one per line:
#   openssl rand -hex 32
# (Hex, so a value is always safe inside a database URL.)

# The public name of the booking engine. Its DNS A record must point at the VPS
# before the first start, or Caddy cannot get a certificate.
BOOKING_DOMAIN=booking.example.com
# Let's Encrypt sends certificate expiry notices here.
ACME_EMAIL=ops@example.com

# Password of the engine's own PostgreSQL. This is not the Supabase database.
BOOKING_DB_PASSWORD=
# Used only by the booking engine.
PAYLOAD_SECRET=
# Shared with the website: set the same value as BOOKING_BRIDGE_SECRET in
# Vercel, server-only (never NEXT_PUBLIC_). At least 32 characters.
BOOKING_BRIDGE_SECRET=

# The image CI publishes from main. Set the tag to a commit SHA to hold a version.
BOOKING_ENGINE_IMAGE=ghcr.io/mukabwadm-ux/nexg-booking-engine
BOOKING_ENGINE_TAG=latest

# ── Discovery engine: started with `docker compose --profile discovery up -d` ──
# Leave these empty until you run it.
# The public name of the discovery engine. Its DNS A record must point at the VPS.
DISCOVERY_DOMAIN=
# The production Supabase project's URL and its public anon (or publishable)
# key, the same pair the website uses. Never the service-role or secret key:
# the engine refuses one.
SUPABASE_URL=
SUPABASE_ANON_KEY=
DISCOVERY_ENGINE_IMAGE=ghcr.io/mukabwadm-ux/nexg-discovery-engine
DISCOVERY_ENGINE_TAG=latest
