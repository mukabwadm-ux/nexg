{
  "name": "nexg-discovery",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "tsc -p tsconfig.test.json && node scripts/test-providers.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "demo-seed": "node scripts/demo-seed/build.ts",
    "demo-seed:check": "node scripts/demo-seed/build.ts --check",
    "demo-seed:extract": "node scripts/demo-seed/build.ts extract"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "lucide-react": "0.546.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.25.12",
    "typescript": "5.8.3",
    "vite": "6.4.3"
  }
}
