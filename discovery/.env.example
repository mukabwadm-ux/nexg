# Existing NexG merchant/catalog API. No database is created by this app.
API_PORT=3001
DISCOVERY_PORT=5180
# Explicit, reversible browser provider choice: platform (the demo API), engine, or supabase. No fallback on an error.
VITE_DISCOVERY_PROVIDER=platform
DISCOVERY_ENGINE_PORT=5190
# VITE_DISCOVERY_PROVIDER=supabase reads Derrick NexG's Supabase straight from the browser (plan step E2):
# the public views merchant_public and catalogue_public, GET only, with the public key.
# Every VITE_ value is built into the page that visitors download, so use the anon or publishable key,
# never the service-role or secret key (the app refuses them). Put real values in .env.local, never in this file.
# Local Supabase: http://127.0.0.1:54321; its anon key is shown by `supabase status` in the Derrick NexG folder.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# The website's checkout page (e.g. /checkout) when Discovery is served on the website's own origin; leave empty in local dev.
VITE_NEXG_CHECKOUT_URL=
