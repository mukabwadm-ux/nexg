# Set in the process environment. No platform service is started automatically.
DISCOVERY_ENGINE_PORT=5190
# Leave the source unset for explicit R0/offline mode.
# The Supabase connector (docs/SUPABASE_CONNECTOR.md): the public anon or publishable key only, never a service-role or secret key.
# DISCOVERY_SOURCE=supabase
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=
# Or the older HTTP source in the demo API's shape (the catalog bridge on 3002):
# DISCOVERY_SOURCE=platform
# DISCOVERY_SOURCE_API_ORIGIN=http://127.0.0.1:3002
